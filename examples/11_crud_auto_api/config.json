{
  "ApplicationName": "11_crud_auto_api",

  "StaticFiles": {
    "RootPath": "./11_crud_auto_api/public"
  },

  // Cookie authentication for simple login (bob and alice)
  "Auth": {
    "CookieAuth": true,
    "CookieAuthScheme": "cookies",
    "CookieValidDays": 1,
    "CookieName": "example_11_auth"
  },

  "NpgsqlRest": {
    "IncludeSchemas": [ "example_11" ],
    "RequiresAuthorization": true,

    "AuthenticationOptions": {
      "DefaultAuthenticationType": "example_11"
    },

    // Enable CRUD endpoint generation from tables
    "CrudSource": {
      "Enabled": true,
      // Only create endpoints for tables with HTTP comment
      "CommentsMode": "OnlyWithHttpTag",
      // Enable all CRUD operations
      "CrudTypes": ["All"]
    },

    "HttpFileOptions": {
      "NamePattern": "./11_crud_auto_api/http/{1}"
    },

    "ClientCodeGen": {
      "FilePath": "./11_crud_auto_api/src/{0}Api.ts"
    }
  }
}
