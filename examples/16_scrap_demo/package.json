{
  "scripts": {
    "build": "bun build ./src/app.ts --outdir ./public",
    "watch": "bun build ./src/app.ts --outdir ./public --watch",
    "dev": "cd .. && bun npgsqlrest ./config.json ./16_scrap_demo/config.json",
    "db:up": "cd .. && bun db up --config=./db.js --migrationDir=./16_scrap_demo/migrations_16",
    "db:list": "cd .. && bun db up --list --config=./db.js --migrationDir=./16_scrap_demo/migrations_16"
  }
}
