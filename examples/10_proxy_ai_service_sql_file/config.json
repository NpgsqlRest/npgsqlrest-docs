{
  "ApplicationName": "10_proxy_ai_service_sql_file",

  "StaticFiles": {
    "RootPath": "./10_proxy_ai_service_sql_file/public"
  },

  "Auth": {
    "CookieAuth": true,
    "CookieAuthScheme": "cookies",
    "CookieValidDays": 1,
    "CookieName": "example_10_auth"
  },

  "NpgsqlRest": {
    "IncludeSchemas": ["example_10"],
    "RequiresAuthorization": true,

    "AuthenticationOptions": {
      "DefaultAuthenticationType": "example_10"
    },

    "ProxyOptions": {
      "Enabled": true,
      "Host": "http://localhost:3001",
      "DefaultTimeout": "00:00:30",
      "ForwardHeaders": true,
      "ExcludeHeaders": ["Host", "Content-Length", "Transfer-Encoding"],
      "ForwardResponseHeaders": true,
      "ExcludeResponseHeaders": ["Transfer-Encoding", "Content-Length"]
    },

    "SqlFileSource": {
      "Enabled": true,
      "FilePattern": "./10_proxy_ai_service_sql_file/sql/**/*.sql"
    },

    "HttpFileOptions": {
      "NamePattern": "./10_proxy_ai_service_sql_file/http/{1}"
    },

    "ClientCodeGen": {
      "FilePath": "./10_proxy_ai_service_sql_file/src/{0}Api.ts"
    }
  }
}
