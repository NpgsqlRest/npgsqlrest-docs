{
  "ApplicationName": "2_static_type_checking_sql_file",

  // Logging configuration: https://npgsqlrest.github.io/config/logging.html
  "Log": {
    "MinimalLevels": {
      "NpgsqlRest": "Debug",
      "NpgsqlRestClient": "Off",
      "NpgsqlRestTest": "Information",
      "System": "Warning",
      "Microsoft": "Warning"
    },
    "ToConsole": true
  },


  "StaticFiles": {
    "RootPath": "./2_static_type_checking_sql_file/public"
  },

  "NpgsqlRest": {
    "RequiresAuthorization": false,
    "QueryStringNullHandling": "EmptyString",

    "RoutineOptions": {
      "Enabled": false
    },

    "SqlFileSource": {
      "Enabled": true,
      "FilePattern": "./2_static_type_checking_sql_file/sql/**/*.sql"
    },

    "HttpFileOptions": {
      "NamePattern": "./2_static_type_checking_sql_file/http/{1}"
    },

    "ClientCodeGen": {
      "FilePath": "./2_static_type_checking_sql_file/src/{0}Api.ts"
    }
  }
}
