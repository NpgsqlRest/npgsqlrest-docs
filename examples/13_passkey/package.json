{
  "scripts": {
    "build": "bun build ./src/app.ts --outdir ./public",
    "watch": "bun build ./src/app.ts --outdir ./public --watch",
    "upstream": "bun run ./upstream/server.ts",
    "dev": "cd .. && bun npgsqlrest ./config.json ./13_passkey/config.json",
    "start": "bun run upstream & sleep 1 && bun run dev",
    "db:up": "cd .. && bun db up --config=./db.js --migrationDir=./13_passkey/sql_13",
    "db:list": "cd .. && bun db up --list --config=./db.js --migrationDir=./13_passkey/sql_13"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
