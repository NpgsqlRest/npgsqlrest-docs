{
  "ApplicationName": "9_http_calls",

  "StaticFiles": {
    "RootPath": "../../npgsqlrest-docs/examples/9_http_calls_sql_file/public"
  },

  // Cookie authentication for simple login (bob and alice)
  "Auth": {
    "CookieAuth": true,
    "CookieAuthScheme": "cookies",
    "CookieValidDays": 1,
    "CookieName": "example_9_auth"
  },

  "NpgsqlRest": {
    "RequiresAuthorization": true,

    "AuthenticationOptions": {
      "DefaultAuthenticationType": "example_9",
      "UseUserParameters": true
    },

    "HttpClientOptions": {
      "Enabled": true
      // "ResponseStatusCodeField": "status_code",
      // "ResponseBodyField": "body",
      // "ResponseHeadersField": "headers",
      // "ResponseContentTypeField": "content_type",
      // "ResponseSuccessField": "success",
      // "ResponseErrorMessageField": "error_message"
    },

    "RoutineOptions": {
      "Enabled": false
    },

    "SqlFileSource": {
      "Enabled": true,
      "FilePattern": "../../npgsqlrest-docs/examples/9_http_calls_sql_file/sql/**/*.sql"
    },

    "HttpFileOptions": {
      "NamePattern": "../../npgsqlrest-docs/examples/9_http_calls_sql_file/http/{1}"
    },

    "ClientCodeGen": {
      "FilePath": "../../npgsqlrest-docs/examples/9_http_calls_sql_file/src/{0}Api.ts"
    }
  }
}
