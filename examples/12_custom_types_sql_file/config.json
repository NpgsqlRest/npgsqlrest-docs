{
  "ApplicationName": "12_custom_types",

  "StaticFiles": {
    "RootPath": "./12_custom_types_sql_file/public"
  },

  "NpgsqlRest": {
    "IncludeSchemas": [ "example_12" ],
    "RequiresAuthorization": false,
    "QueryStringNullHandling": "EmptyString",

    "RoutineOptions": {
      "Enabled": false
    },

    "SqlFileSource": {
      "Enabled": true,
      "FilePattern": "./12_custom_types_sql_file/sql/**/*.sql"
    },

    "HttpFileOptions": {
      "NamePattern": "./12_custom_types_sql_file/http/{1}"
    },

    "ClientCodeGen": {
      "FilePath": "./12_custom_types_sql_file/src/{0}Api.ts"
    }
  }
}
