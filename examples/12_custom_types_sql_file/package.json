{
  "scripts": {
    "build": "bun build ./src/app.ts --outdir ./public",
    "watch": "bun build ./src/app.ts --outdir ./public --watch",
    "dev": "cd .. && bun npgsqlrest ./config.json ./12_custom_types_sql_file/config.json",
    "db:up": "cd .. && bun db up --config=./db.js --migrationDir=./12_custom_types_sql_file/migrations_12",
    "db:list": "cd .. && bun db up --list --config=./db.js --migrationDir=./12_custom_types_sql_file/migrations_12"
  }
}
