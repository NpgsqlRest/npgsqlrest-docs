@host=http://127.0.0.1:8080

// function example_10.ai_analyze(
//     _text text,
//     _max_length integer DEFAULT 150,
//     _max_keywords integer DEFAULT 5,
//     _proxy_status_code integer DEFAULT NULL::integer,
//     _proxy_body text DEFAULT NULL::text,
//     _proxy_success boolean DEFAULT NULL::boolean,
//     _proxy_error_message text DEFAULT NULL::text
// )
// returns json
//
// comment on function example_10.ai_analyze is 'HTTP POST /ai/analyze
// authorize
// proxy POST';
POST {{host}}/ai/analyze
content-type: application/json

{
    "text": "ABC",
    "maxLength": 2,
    "maxKeywords": 3,
    "proxyStatusCode": 4,
    "proxyBody": "XYZ",
    "proxySuccess": true,
    "proxyErrorMessage": "ABC"
}

