{
  "scripts": {
    "build": "bun build ./src/app.ts --outdir ./public",
    "watch": "bun build ./src/app.ts --outdir ./public --watch",
    "dev": "cd .. && bun npgsqlrest ./config.json ./17_scrap_demo_2/config.json",
    "db:up": "cd .. && bun db up --config=./db.js --migrationDir=./17_scrap_demo_2/migrations_17",
    "db:list": "cd .. && bun db up --list --config=./db.js --migrationDir=./17_scrap_demo_2/migrations_17"
  }
}
