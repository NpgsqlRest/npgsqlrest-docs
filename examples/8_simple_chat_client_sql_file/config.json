{
  "ApplicationName": "8_simple_chat_client",

  "StaticFiles": {
    "RootPath": "./8_simple_chat_client_sql_file/public"
  },

  // Cookie authentication for simple login (bob and alice)
  "Auth": {
    "CookieAuth": true,
    "CookieAuthScheme": "cookies",
    "CookieValidDays": 1,
    "CookieName": "example_8_auth"
  },

  "NpgsqlRest": {
    "RequiresAuthorization": true,

    "AuthenticationOptions": {
      "DefaultAuthenticationType": "example_8",
      "UseUserParameters": true
    },

    "RoutineOptions": {
      "Enabled": false
    },

    "SqlFileSource": {
      "Enabled": true,
      "FilePattern": "./8_simple_chat_client_sql_file/sql/**/*.sql"
    },

    "HttpFileOptions": {
      "NamePattern": "./8_simple_chat_client_sql_file/http/{1}"
    },

    "ClientCodeGen": {
      "FilePath": "./8_simple_chat_client_sql_file/src/{0}Api.ts",
      // Export event source clients for SSE endpoints so we can use them in the chat client 
      // and listen for new messages.
      "ExportEventSources": true
    }
  }
}
